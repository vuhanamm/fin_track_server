# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/fintrack

# Firebase Admin SDK — paste JSON content as single line string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# AI Providers (fallback order: Gemini → Groq → Cerebras)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Google Play Developer API — service account JSON
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Gmail alert (dùng App Password — https://myaccount.google.com/apppasswords)
MAIL_USER=your_gmail@gmail.com
MAIL_APP_PASSWORD=your_app_password_here

# Server
PORT=3000
NODE_ENV=development
